DATABASE_URL=postgres://bower:bower@localhost:5432/bower
# Set to "true" to run pending Drizzle migrations automatically on startup.
# Recommended for development; omit in production where migrations should be
# applied as a controlled pre-deployment step.
AUTO_MIGRATE=true
# Stable across every instance in a multi-instance deployment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Override when publishing the bundled proxy images under another registry.
BOWER_CADDY_IMAGE=ghcr.io/clofour/bower-caddy:latest
BOWER_PROXY_SYNC_IMAGE=ghcr.io/clofour/bower-proxy-sync:latest
# Host-mode listener ports for each environment's managed ingress proxy.
BOWER_PROXY_HTTP_PORT=80
BOWER_PROXY_HTTPS_PORT=443
# Server-side deployment health, canary, and auto-rollback reconciliation cadence.
BOWER_RECONCILE_INTERVAL=5
